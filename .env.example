POSTGRES_USER="username"
POSTGRES_PASSWORD="password"
POSTGRES_DB="project"

DATABASE_URL="postgresql+psycopg2://username:password@db:5432/project"
TEST_DATABASE_URL = "postgresql+psycopg2://username:password@db:5432/project_test"


AUTH0_DOMAIN = "your-tenant.jp.auth0.com"
AUTH0_AUDIENCE = "https://api.taskal.example"
# 任意：Auth0 Actionでアクセストークンに追加するメールアドレスのクレーム名
AUTH0_EMAIL_CLAIM = "https://taskal.app/email"

# フロントエンド（Vite）用：Auth0のSPA Applicationの値。VITE_ で始まる変数はブラウザに公開されるため秘密情報は書かないこと
VITE_AUTH0_DOMAIN = "your-tenant.jp.auth0.com"
VITE_AUTH0_CLIENT_ID = "your-spa-client-id"
VITE_AUTH0_AUDIENCE = "https://api.taskal.example"
